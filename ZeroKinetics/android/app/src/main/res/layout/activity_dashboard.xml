<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingTop="80dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvDashTitle1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_title_line1"
        style="@style/TextAppearance.ZeroKinetics.Heading1" />

    <TextView
        android:id="@+id/tvDashTitle2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_title_line2"
        style="@style/TextAppearance.ZeroKinetics.Heading2" />

    <!-- Verified badge -->
    <TextView
        android:id="@+id/tvVerified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/dashboard_verified"
        android:textColor="@color/success"
        android:textSize="16sp"
        android:textStyle="bold"
        android:drawablePadding="8dp" />

    <!-- Welcome message -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <!-- Info card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_glass_input"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session Info"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSessionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Join Session Button -->
    <Button
        android:id="@+id/btnJoinSession"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_input_minimal"
        android:text="Join Session"
        android:textColor="@color/accent_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_gradient_button"
        android:text="@string/btn_logout"
        style="@style/Widget.ZeroKinetics.Button" />

</LinearLayout>
